# ==========================================
# CẤU HÌNH SẾP AI REMOTE (MÔI TRƯỜNG MẪU)
# ==========================================

# --- BACKEND SERVER CONFIGURATION ---
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=sep_ai_remote_super_secret_jwt_key_2026
PAIRING_CODE=888999
CORS_ORIGIN=*

# CSDL (Mặc định dùng SQLite cục bộ hoặc cấu hình Postgres)
DATABASE_TYPE=sqlite
DATABASE_FILE=./data/sep_ai.db
# POSTGRES_URL=postgresql://postgres:password@localhost:5432/sep_ai_remote

# PUSH NOTIFICATION (FCM / WebPush)
FCM_SERVER_KEY=your_firebase_cloud_messaging_server_key_here
ENABLE_MOCK_PUSH=true

# --- WINDOWS AGENT BRIDGE CONFIGURATION ---
BACKEND_WS_URL=ws://127.0.0.1:3000/ws
BACKEND_HTTP_URL=http://127.0.0.1:3000
BRIDGE_DEVICE_NAME=Windows_PC_Antigravity
BRIDGE_PAIRING_CODE=888999
HOOK_SERVER_PORT=59123

# ĐƯỜNG DẪN ANTIGRAVITY TRÊN WINDOWS
ANTIGRAVITY_APP_DATA_DIR=C:\Users\PC\.gemini\antigravity
ANTIGRAVITY_AGENTAPI_PATH=C:\Users\PC\.gemini\antigravity\bin\agentapi.bat

# THỜI GIAN NHỊP TIM VÀ QUÉT DỮ LIỆU (MILLISECONDS)
HEARTBEAT_INTERVAL_MS=5000
POLL_INTERVAL_MS=1000
